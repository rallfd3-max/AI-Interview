<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itzixi.mapper.InterviewRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.itzixi.pojo.InterviewRecord">
        <id column="id" property="id" />
        <result column="candidate_id" property="candidateId" />
        <result column="job_id" property="jobId" />
        <result column="job_name" property="jobName" />
        <result column="answer_content" property="answerContent" />
        <result column="take_time" property="takeTime" />
        <result column="result" property="result" />
        <result column="create_time" property="createTime" />
        <result column="updated_time" property="updatedTime" />
        <result column="totalscore" property="totalscore" />
        <result column="offer_status" property="offer_status" />
        <result column="analysis" property="analysis" />
        <result column="interviewresult" property="interviewresult"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, candidate_id, job_id,job_name, answer_content, take_time, result,totalscore, create_time, updated_time,offer_status,analysis.interviewresult
    </sql>

</mapper>

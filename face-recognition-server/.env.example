APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
DATABASE_URL=sqlite:///./data/database/face.db
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=./data/face_models
FACE_DEVICE=cpu
ALLOW_MODEL_DOWNLOAD=false
# Initial example only: calibrate with your own held-out photos.
FACE_MATCH_THRESHOLD=0.65
FACE_MATCH_TOP_K=3
PERSON_SCORE_STRATEGY=max
PERSON_SCORE_TOP_N=2
STABLE_FRAME_COUNT=3
SESSION_TIMEOUT_SECONDS=10
MAX_IMAGE_SIZE_MB=8
MAX_IMAGE_PIXELS=20000000
RETURN_DEBUG_INFO=true
SAVE_DEBUG_IMAGES=false
ALLOW_MULTIPLE_FACES=false
MAX_REQUESTS_PER_SECOND=5
REQUEST_CACHE_TTL_SECONDS=30
REQUEST_CACHE_SIZE=512
MAX_PENDING_JOBS=8
